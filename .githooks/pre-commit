#!/bin/bash
# Pre-commit: cargo check workspace
# A fast no-compile check — skips all cargo run/test/build overhead.
# Catches type errors, missing imports, wrong signatures.

set -e

echo "=== pre-commit: cargo check --workspace ==="
cargo check --workspace 2>&1

echo "=== pre-commit: cargo doc --no-deps ==="
RUSTDOCFLAGS="-Dwarnings" cargo doc --no-deps -p atom_terrain 2>&1

echo "=== pre-commit: bevy_lint ==="
echo "=== pre-commit: agent-spec guard ==="
if "$HOME/.cargo/bin/agent-spec" --version &>/dev/null && [ -d .claude/specs ]; then
    "$HOME/.cargo/bin/agent-spec" guard --spec-dir .claude/specs --code . --change-scope staged 2>&1 || echo "WARN: spec guard issues (non-blocking)"
fi

echo "=== pre-commit: OK ==="
