#!/bin/bash
# Pre-commit: cargo check workspace
# A fast no-compile check — skips all cargo run/test/build overhead.
# Catches type errors, missing imports, wrong signatures.

set -e

echo "=== pre-commit: cargo check --workspace ==="
cargo check --workspace 2>&1

echo "=== pre-commit: cargo doc --no-deps ==="
RUSTDOCFLAGS="-Dwarnings" cargo doc --no-deps -p atom_terrain 2>&1

echo "=== pre-commit: review checklist ==="
echo "  ☐ TENSIONS.md updated with new discoveries?"
echo "  ☐ bevy-kb updated with new API patterns?"
echo "  ☐ No leftover debug prints / dead code?"
echo "=== pre-commit: bevy_lint ==="
if command -v bevy_lint &>/dev/null; then
    bevy_lint 2>&1
else
    echo "WARN: bevy_lint not installed, skipping"
fi
echo "=== pre-commit: agent-spec lifecycle ==="
if "$HOME/.cargo/bin/agent-spec" --version &>/dev/null && [ -d .omp/specs ]; then
    for spec in .omp/specs/*.spec; do
        echo "  lifecycle: $spec"
        "$HOME/.cargo/bin/agent-spec" lifecycle "$spec" --code . 2>&1 | python3 -c "
import sys, json
d = json.load(sys.stdin)
s = d['verification']['summary']
print(f\"    {s['total']} scenarios: {s['passed']} passed, {s['failed']} failed, {s['skipped']} skipped\")
if s['failed'] > 0 or not d['passed']:
    sys.exit(1)
"
    done
else
    echo "WARN: agent-spec not available, skipping lifecycle check"
fi
echo "=== pre-commit: agent-spec guard ==="
if "$HOME/.cargo/bin/agent-spec" --version &>/dev/null && [ -d .omp/specs ]; then
    "$HOME/.cargo/bin/agent-spec" guard --spec-dir .omp/specs --code . --change-scope staged 2>&1 || echo "WARN: spec guard issues (non-blocking)"
fi

echo "=== pre-commit: OK ==="
