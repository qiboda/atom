#!/bin/bash
# pre-commit hook — fast checks before commit.
# Full suite (clippy + nextest + ref #N) runs in pre-push.

set -e

has_error=0

echo "pre-commit: cargo fmt --check..."
if ! cargo fmt --check 2>&1; then
    echo "  ERROR: cargo fmt --check found unformatted code."
    echo "  Run 'cargo fmt' and commit the changes."
    has_error=1
fi

echo "pre-commit: cargo check --workspace..."
if ! cargo check --workspace 2>&1; then
    echo "  ERROR: cargo check found compile errors."
    has_error=1
fi

echo "pre-commit: cargo doc --no-deps (missing_docs)..."
if ! RUSTDOCFLAGS="-Dwarnings" cargo doc --no-deps --workspace 2>&1; then
    echo "  ERROR: cargo doc found missing docs or warnings."
    echo "  Add /// doc comments to all public items and re-run."
    has_error=1
fi

echo "pre-commit: bevy_lint..."
if command -v bevy_lint &>/dev/null; then
    if ! bevy_lint 2>&1; then
        echo "  ERROR: bevy_lint found issues."
        has_error=1
    fi
else
    echo "  WARN: bevy_lint not installed, skipping"
fi

if [ $has_error -ne 0 ]; then
    echo ""
    echo "Run: cargo fmt && cargo check --workspace"
    exit 1
fi

echo "pre-commit: OK"
