#!/bin/bash
# commit-msg hook — enforce issue references for all commits.
#
# Every commit MUST reference an issue via "ref #N".
# No exceptions — feat, fix, test, docs, chore all included.

COMMIT_MSG_FILE="$1"

# 定位 gh：优先 PATH，其次 Windows 默认安装路径（git bash 常因会话 PATH 过期而看不到）。
# 找不到时必须显式报错——静默回退会让"命令缺失"伪装成"issue 不存在"。
find_gh() {
    if command -v gh >/dev/null 2>&1; then
        command -v gh
    elif [ -x "/c/Program Files/GitHub CLI/gh.exe" ]; then
        echo "/c/Program Files/GitHub CLI/gh.exe"
    fi
}

# Skip merge and revert commits
head -1 "$COMMIT_MSG_FILE" | grep -qE "^(Merge|Revert)" && exit 0

if ! grep -qiE "ref[[:space:]]+#[0-9]+" "$COMMIT_MSG_FILE"; then
    echo "ERROR: every commit must reference a GitHub issue with 'ref #N'."
    echo ""
    echo "  Example:"
    echo "    feat: add thing"
    echo ""
    echo "    ref #1"
    echo ""
    exit 1
fi

# Validate issue references exist and are OPEN
issues=$(grep -ioE "ref[[:space:]]+#[0-9]+" "$COMMIT_MSG_FILE" \
    | grep -oE '#[0-9]+' \
    | tr -d '#' \
    | sort -u \
    || true)

if [ -n "$issues" ]; then
    GH_BIN="$(find_gh)"
    if [ -z "$GH_BIN" ]; then
        echo ""
        echo "ERROR: commit rejected — 'gh' (GitHub CLI) not found."
        echo ""
        echo "  Tried PATH and '/c/Program Files/GitHub CLI/gh.exe'."
        echo "  Install it or fix PATH, otherwise issue state cannot be verified:"
        echo "    winget install --id GitHub.cli"
        echo ""
        exit 1
    fi

    for n in $issues; do
        state=$(unset GITHUB_TOKEN 2>/dev/null; "$GH_BIN" issue view "$n" --repo qiboda/atom --json state --jq '.state' 2>/dev/null || echo "MISSING")

        if [ "$state" != "OPEN" ]; then
            echo ""
            echo "ERROR: commit rejected — issue #$n is $state (must be OPEN)."
            echo ""
            if [ "$state" = "MISSING" ]; then
                echo "  Either issue #$n does not exist, or 'gh' is not authenticated."
                echo "  Check with: gh issue view $n --repo qiboda/atom"
                echo "  Authenticate with: gh auth login"
            else
                echo "  Issue #$n is $state. Reopen it with 'gh issue reopen $n'."
            fi
            echo ""
            exit 1
        fi
    done
fi

exit 0
