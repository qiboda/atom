#!/bin/bash
# pre-push hook — verify quality gates and GitHub issue references.
#
# 1. cargo check (workspace)
# 2. cargo clippy (must be warning-free)
# 3. cargo doc (must be warning-free)
# 4. bevy_lint (if installed)
# 5. cargo nextest (fallback: cargo test)
# 6. "ref #N" in commit messages must point to open issues
#
# CI gating for PRs is enforced by branch protection on main.

has_error=0

# --- Quality gate: cargo check ---
echo "pre-push: cargo check --workspace..."
if ! cargo check --workspace 2>&1; then
    echo ""
    echo "ERROR: cargo check found compile errors."
    echo ""
    has_error=1
fi

# --- Quality gate: cargo clippy ---
echo "pre-push: cargo clippy --workspace -- -A dead_code -D warnings..."
if ! cargo clippy --workspace -- -A dead_code -D warnings 2>&1; then
    echo ""
    echo "ERROR: cargo clippy produced warnings."
    echo "  Fix clippy warnings before pushing."
    echo ""
    has_error=1
fi

# --- Quality gate: cargo doc ---
echo "pre-push: cargo doc --no-deps --workspace (must be warning-free)..."
if ! RUSTDOCFLAGS="-Dwarnings" cargo doc --no-deps --workspace 2>&1; then
    echo ""
    echo "ERROR: cargo doc produced warnings or errors."
    echo "  Add /// doc comments to all public items and re-run."
    echo ""
    has_error=1
fi

# --- Quality gate: bevy_lint ---
echo "pre-push: bevy_lint..."
if command -v bevy_lint &>/dev/null; then
    if ! bevy_lint 2>&1; then
        echo ""
        echo "ERROR: bevy_lint found issues."
        echo ""
        has_error=1
    fi
else
    echo "  WARN: bevy_lint not installed, skipping"
fi

# --- Quality gate: cargo deny ---
echo "pre-push: cargo deny check..."
if command -v cargo-deny &>/dev/null; then
    if ! cargo deny check 2>&1; then
        echo ""
        echo "ERROR: cargo deny found issues (advisories/bans/licenses)."
        echo ""
        has_error=1
    fi
else
    echo "  WARN: cargo-deny not installed, skipping"
fi

# --- Quality gate: cargo test ---
echo "pre-push: cargo test --workspace..."
if command -v cargo-nextest &>/dev/null; then
    if ! cargo nextest run --workspace 2>&1; then
        echo ""
        echo "ERROR: nextest tests failed."
        echo ""
        has_error=1
    fi
else
    echo "  WARN: cargo-nextest not installed, falling back to cargo test"
    if ! cargo test --workspace 2>&1; then
        echo ""
        echo "ERROR: cargo test failed."
        echo ""
        has_error=1
    fi
fi

# --- Issue reference validation ---

while read -r local_ref local_oid remote_ref remote_oid; do
    # Skip branch deletion
    if [ "$local_oid" = "0000000000000000000000000000000000000000" ]; then
        continue
    fi

    # Nothing new to push
    if [ "$remote_oid" = "$local_oid" ]; then
        continue
    fi

    # Determine commit range — only scan commits unique to this push.
    # For new branches, find the merge-base with origin/main so we
    # don't scan the entire reachable history.
    # Always exclude commits already on origin/main (e.g. after a rebase,
    # main's commits — with their closed-issue refs — must not be rescanned).
    if [ "$remote_oid" = "0000000000000000000000000000000000000000" ]; then
        base=$(git merge-base origin/main "$local_oid" 2>/dev/null \
            || echo "")
        if [ -n "$base" ]; then
            range="${base}..${local_oid}"
        else
            range="$local_oid"
        fi
    else
        range="${remote_oid}..${local_oid}"
    fi
    # Exclusion applied at call sites: git log $range --not origin/main
    excl_origin="--not origin/main"

    # Detect malformed ref references: standalone "ref" not followed by #N.
    # ref must be preceded by line start, whitespace, or '(' — legal refs only
    # appear there. This excludes code/term fragments like --abbrev-ref,
    # \<ref\>, or refactored (ref #97).
    all_refs=$(git log "$range" $excl_origin --format="%B" 2>/dev/null | grep -ciE '(^|[[:space:](])ref[[:space:]]+')
    valid_refs=$(git log "$range" $excl_origin --format="%B" 2>/dev/null | grep -ciE '(^|[[:space:](])ref[[:space:]]+#[0-9]+')

    if [ "$all_refs" -gt "$valid_refs" ]; then
        echo ""
        echo "ERROR: malformed 'ref' reference in commit message."
        echo "  Found 'ref' without a valid GitHub issue number."
        echo "  Use 'ref #N' format (e.g., 'ref #23')."
        echo "  If this is a chore/docs/test commit, remove the 'ref' keyword entirely."
        echo ""
        has_error=1
        continue
    fi

    # Extract issue references from all commits in the range
    issues=$(git log "$range" $excl_origin --format="%B" 2>/dev/null \
        | grep -ioE '(^|[[:space:](])ref[[:space:]]+#[0-9]+' \
        | grep -oE '#[0-9]+' \
        | sort -u \
        | tr -d '#' \
        || true)

    if [ -z "$issues" ]; then
        echo ""
        echo "ERROR: push rejected — no 'ref #N' found in commit messages."
        echo "  Every commit must reference an open GitHub issue."
        echo "  Add 'ref #N' to at least one commit in this push."
        echo ""
        has_error=1
        continue
    fi

    for n in $issues; do
        state=$(unset GITHUB_TOKEN 2>/dev/null; gh issue view "$n" --repo qiboda/atom --json state --jq '.state' 2>/dev/null || echo "MISSING")

        if [ "$state" != "OPEN" ]; then
            echo ""
            echo "ERROR: push rejected — issue #$n is $state (must be OPEN)."
            echo ""
            if [ "$state" = "MISSING" ]; then
                echo "  Issue #$n does not exist. Create it with 'gh issue create'."
            else
                echo "  Issue #$n is $state. Reopen it with 'gh issue reopen $n'."
            fi
            echo ""
            has_error=1
        fi
    done
done

if [ $has_error -ne 0 ]; then
    exit 1
fi
echo "pre-push: OK"
exit 0
