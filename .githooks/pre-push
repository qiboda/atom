#!/bin/bash
# Pre-push: cargo clippy + cargo test
# Catches warnings, clippy lints, and test failures before pushing.
# Run with --no-verify to skip.

set -e

echo "=== pre-push: cargo check --workspace ==="
cargo check --workspace 2>&1

echo "=== pre-push: cargo clippy --workspace ==="
cargo clippy --workspace -- -A dead_code 2>&1

echo "=== pre-push: bevy_lint ==="
$HOME/.cargo/bin/bevy_lint 2>&1

echo "=== pre-push: cargo test --workspace (nextest) ==="
cargo nextest run --workspace 2>&1

echo "=== pre-push: OK ==="
